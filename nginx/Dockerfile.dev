# =============================================================================
# prod-ready-backend - Development Nginx Dockerfile
# Lightweight Alpine-based image optimized for development and load testing
# =============================================================================

FROM nginx:1.27-alpine

# Install additional tools useful for development
RUN apk add --no-cache \
    wget \
    curl \
    bash

# Remove default nginx config
RUN rm -f /etc/nginx/conf.d/default.conf

# Create necessary directories with proper permissions
RUN mkdir -p /var/log/nginx /var/cache/nginx /var/run/nginx \
    && chown -R nginx:nginx /var/log/nginx /var/cache/nginx /var/run/nginx

# Note: Configuration files are mounted as volumes in docker-compose.yml
# - nginx.dev.conf -> /etc/nginx/nginx.conf
# - conf.d/ -> /etc/nginx/conf.d/

EXPOSE 80

# Run as root in development to avoid permission issues
# In production, we use non-root user
CMD ["nginx", "-g", "daemon off;"]
