# =============================================================================
# Environment Configuration Example
# =============================================================================
# Copy this file to .env.local, .env.dev, or .env.prod and configure as needed.
# Place environment-specific files in: backend/core/conf/envs/
#
# ENV_STAGE controls which file is loaded: local, dev, prod
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=Prod Ready Backend API
ENVIRONMENT=local                    # local, dev, prod
LOG_LEVEL=INFO                       # DEBUG, INFO, WARNING, ERROR
LOGGER_NAME=prod-ready-backend
JSON_LOGS=false                      # true for production (JSON format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
MAX_CONCURRENT_REQUESTS=100          # Admission control limit

# -----------------------------------------------------------------------------
# Database Settings (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_ENGINE=postgresql+asyncpg
POSTGRES_USER=prod_user
POSTGRES_PASSWORD=prod_password
POSTGRES_DB=prod_ready_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Or use full DATABASE_URL:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# Database Connection Pool
DB_POOL_SIZE=10                      # Connections to keep in pool
DB_MAX_OVERFLOW=20                   # Extra connections when pool exhausted
DB_POOL_TIMEOUT=30                   # Seconds to wait for connection
DB_POOL_RECYCLE=1800                 # Recycle connections after 30 min

# Database Circuit Breaker
DB_CIRCUIT_BREAKER_FAILURE_THRESHOLD=20
DB_CIRCUIT_BREAKER_RESET_TIMEOUT=10

# -----------------------------------------------------------------------------
# Redis Settings
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=redis
REDIS_DB=0
# Or use full REDIS_URL:
# REDIS_URL=redis://localhost:6379/0

# Redis Circuit Breaker
REDIS_CIRCUIT_BREAKER_FAILURE_THRESHOLD=10
REDIS_CIRCUIT_BREAKER_RESET_TIMEOUT=30

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# IMPORTANT: Generate a strong secret for production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=<GENERATE_STRONG_SECRET_DO_NOT_USE_THIS_VALUE>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30
JWT_AUDIENCE=prb-frontend
JWT_ISSUER=prb-api
REFRESH_TOKEN_ROTATION_ENABLED=true
REFRESH_TOKEN_CLEANUP_DAYS=90

# -----------------------------------------------------------------------------
# API Settings
# -----------------------------------------------------------------------------
API_V1_PREFIX=/api/v1
# API_KEY=                           # Auto-generated if not set
# API_SECRET=                        # Auto-generated if not set

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# -----------------------------------------------------------------------------
# Admin Panel
# -----------------------------------------------------------------------------
# IMPORTANT: Set a strong password in production (16+ chars, mixed case, digits, special)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourSecurePassword123!
ADMIN_ALLOWED_IPS=["127.0.0.1","::1"]
ADMIN_SESSION_TIMEOUT_MINUTES=30

# Admin MFA (Required in production)
ADMIN_MFA_ENABLED=false              # Must be true in production
ADMIN_MFA_SECRET=                    # Generate with: python -c 'import pyotp; print(pyotp.random_base32())'
ADMIN_MFA_ISSUER_NAME=PRB Admin
ADMIN_MFA_TOKEN_VALIDITY_SECONDS=30

# -----------------------------------------------------------------------------
# Google OAuth (used by identity-plan-kit)
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# -----------------------------------------------------------------------------
# Caching
# -----------------------------------------------------------------------------
USER_CACHE_TTL_MINUTES=30

# -----------------------------------------------------------------------------
# Profiling (Pyinstrument)
# -----------------------------------------------------------------------------
PROFILING_ENABLED=false
PROFILE_SAMPLE_RATE=0.001            # 0.1% sampling
REQUIRE_PROFILE_HEADER=false
PROFILE_HEADER_TOKEN=
PROFILED_ENDPOINTS=[]                # Empty = all endpoints
PROFILE_RETENTION_DAYS=7
PROFILE_INTERVAL_MS=1.0

# -----------------------------------------------------------------------------
# Prometheus Metrics
# -----------------------------------------------------------------------------
METRICS_ENABLED=false                # Set true to enable /metrics endpoint
METRICS_ENDPOINT=/metrics
METRICS_EXCLUDE_PATHS=["/health","/metrics","/ready","/live"]

# -----------------------------------------------------------------------------
# OpenTelemetry Tracing
# -----------------------------------------------------------------------------
TRACING_ENABLED=false                # Set true to enable distributed tracing
OTEL_EXPORTER_OTLP_ENDPOINT=         # e.g., http://localhost:4317
OTEL_SERVICE_NAME=                   # Defaults to APP_NAME if empty
OTEL_TRACES_SAMPLER=parentbased_traceidratio  # always_on, always_off, parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1          # 10% sampling rate
OTEL_EXPORTER_OTLP_INSECURE=true

# -----------------------------------------------------------------------------
# Audit Logging
# -----------------------------------------------------------------------------
AUDIT_ENABLED=false                  # Set true to persist audit logs to database
AUDIT_LOG_TO_STDOUT=true             # Also log audit events via structlog
AUDIT_RETENTION_DAYS=90              # Days to keep audit logs
AUDIT_SENSITIVE_FIELDS=["password","token","secret","api_key","credit_card"]

# -----------------------------------------------------------------------------
# GeoIP (MaxMind)
# -----------------------------------------------------------------------------
# GEOIP_DB_PATH=/path/to/cities.mmdb

# -----------------------------------------------------------------------------
# Server Settings (Granian ASGI)
# -----------------------------------------------------------------------------
# These are set in Dockerfile but can be overridden at runtime
GRANIAN_WORKERS=8                    # Number of worker processes
GRANIAN_BACKLOG=2048                 # TCP connection backlog
GRANIAN_BACKPRESSURE=512             # Max concurrent connections per worker
